    after  = json.load(open("after.json"))
    for c_b, c_a in zip(before["configs"], after["configs"]):
        speedup = c_a['throughput_sps'] / c_b['throughput_sps']
        print(f"  B={c_b['batch']}: speedup = {speedup:.2f}x")

